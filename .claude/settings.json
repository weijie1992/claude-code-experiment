{
  "permissions": {
    "allow": ["Bash(git switch:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; ./node_modules/.bin/prettier --write \"$f\" --ignore-unknown; } 2>/dev/null || true",
            "statusMessage": "Running prettier..."
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{tool: .tool_name, input: .tool_input, at: (now | todate)}' | { read -r entry; f=tool-used.json; arr=$([ -s \"$f\" ] && cat \"$f\" || echo \"[]\"); echo \"$arr\" | jq --argjson e \"$entry\" '. + [$e]' > \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Logging tool use..."
          }
        ]
      }
    ]
  }
}
